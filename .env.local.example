MONDAY_API_TOKEN=
CRON_SECRET=
# Segredo do webhook da monday (npm run webhooks:registrar gera se faltar; no Vercel, o mesmo valor).
MONDAY_WEBHOOK_SECRET=

# Scripts locais de fotos (npm run fotos:bucket / fotos:enviar) e envio de push no servidor (src/lib/push/enviar.ts,
# o único código do app que a lê). Nunca em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (npm run push:chaves gera as três e acrescenta ao .env.local; no Vercel, as mesmas).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:marcos.porto@brbseguros.com.br
